# Nginx reverse proxy cho website gia phả Nguyễn Bá
# Đặt file này tại: /etc/nginx/sites-available/giapha
# Rồi: ln -s /etc/nginx/sites-available/giapha /etc/nginx/sites-enabled/
#      nginx -t && systemctl reload nginx
#
# Thay "giapha.abc.vn" bằng domain thật của bạn.

server {
    listen 80;
    server_name giapha.abc.vn;

    # Cho phép Certbot xác thực (Let's Encrypt)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Giới hạn kích thước upload ảnh (chỉnh theo nhu cầu)
    client_max_body_size 20M;
}

# Sau khi chạy Certbot (certbot --nginx -d giapha.abc.vn), Certbot sẽ tự
# thêm block listen 443 ssl và chuyển hướng 80 -> 443.
