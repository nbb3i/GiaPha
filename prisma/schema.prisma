// Prisma schema — Gia phả dòng họ Nguyễn Bá
// Mô hình khớp dữ liệu thật (module gia-pha NukeViet). Xem docs/THIET-KE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GioiTinh {
  NAM
  NU
  KHONG_RO
}

/// Tình trạng sinh tử (status gốc)
enum TinhTrang {
  SONG
  MAT
  KHONG_RO
}

/// Quan hệ trong gia phả (relationships gốc)
enum QuanHe {
  CON // con cháu huyết thống
  VO_CHONG // vợ/chồng (dâu/rể)
  KHAC
}

enum VaiTro {
  KHACH
  BIENTAP
  ADMIN
}

enum TrangThai {
  NHAP
  HIEN
}

enum LoaiTin {
  TIN_TUC
  GIO_TO
  HOP_HO
  THONG_BAO
}

/// Một người trong gia phả.
/// Vợ/chồng cũng là một Person (quanHe = VO_CHONG), liên kết qua parentId.
/// Con cháu có quanHe = CON, liên kết cha qua parentId và mẹ qua motherId.
model Person {
  id  Int @id // giữ id gốc để ánh xạ cha/mẹ khi nhập liệu
  gid Int @default(1) // thuộc dòng họ (genealogy) nào

  parentId Int? // cha (hoặc người phối ngẫu nếu quanHe = VO_CHONG)
  motherId Int? // mẹ
  thuTu    Int    @default(1) // con/vợ thứ mấy (weight)
  doi      Int    @default(1) // đời thứ (lev)

  quanHe    QuanHe    @default(CON)
  gioiTinh  GioiTinh  @default(KHONG_RO)
  tinhTrang TinhTrang @default(KHONG_RO)

  // Các loại tên
  hoTen    String // tên húy — tên khai sinh / cúng cơm (full_name)
  maHieu   String? // số mã hiệu (code)
  tenTu    String? // tên tự (name1)
  tenThuy  String? // tên thụy/truy phong sau khi mất (name2)
  tenKhac1 String? // (name3)
  tenKhac2 String? // (name4)
  chucVu   String? // chức vụ, phẩm hàm (regency)
  alias    String?

  // Sinh - tử (chuỗi tự do: âm/dương lịch, có thể khuyết)
  ngaySinh    String? // birthday
  ngayMat     String? // dieday
  ngayGio     String? // anniversary (vd "24/2")
  hienNgayGio Boolean @default(false) // actanniversary
  huongTho    Int? // life
  moTang      String? // nơi an táng (burial)

  noiDung String? @db.Text // sự nghiệp, công đức, ghi chú (content)
  anh     String? // ảnh chân dung (image)

  hienThi   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quan hệ tự tham chiếu
  cha        Person?  @relation("Cha", fields: [parentId], references: [id], onDelete: SetNull)
  conTheoCha Person[] @relation("Cha")
  me         Person?  @relation("Me", fields: [motherId], references: [id], onDelete: SetNull)
  conTheoMe  Person[] @relation("Me")

  @@index([parentId])
  @@index([motherId])
  @@index([doi])
  @@index([gid])
}

/// Thông tin một dòng họ / phả hệ (genealogy).
model Genealogy {
  id          Int     @id // gid gốc
  tieuDe      String // title
  alias       String?
  moTa        String? @db.Text // description
  tocUoc      String? @db.Text // rule — tộc ước / gia quy
  noiDung     String? @db.Text // content
  hienThiVo   Boolean @default(true) // show_wife
  soThanhVien Int     @default(0) // number
  nam         String? // years
  tacGia      String? // author
  nguoiLienHe String? // full_name — người phụ trách
  dienThoai   String? // telephone
  email       String?
  anh         String? // image

  createdAt DateTime @default(now())
}

/// Tài khoản người dùng.
model User {
  id           String  @id @default(cuid())
  username     String  @unique
  email        String? @unique
  passwordHash String
  hoTen        String?
  vaiTro       VaiTro  @default(KHACH)

  tinTuc TinTuc[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Tin tức / sự kiện dòng họ.
model TinTuc {
  id         String    @id @default(cuid())
  tieuDe     String
  slug       String    @unique
  noiDung    String    @db.Text
  anhBia     String?
  loai       LoaiTin   @default(TIN_TUC)
  ngayDienRa DateTime?
  tacGiaId   String?
  tacGia     User?     @relation(fields: [tacGiaId], references: [id], onDelete: SetNull)
  trangThai  TrangThai @default(HIEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loai])
}
